FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y python3 python3-pip python3-venv build-essential cmake libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev libgl1-mesa-dev libxcb-cursor0 libxkbcommon-x11-0 libegl1 && rm -rf /var/lib/apt/lists/*
WORKDIR /project
COPY . /project
RUN rm -rf runtimes releases && python3 -m venv /opt/build-venv && /opt/build-venv/bin/pip install PySide6-Essentials==6.11.2 pyinstaller==6.22.3 && /opt/build-venv/bin/python packaging/build-runtime.py && /opt/build-venv/bin/python packaging/archive-release.py
CMD ["bash","-c","cp releases/*.zip /out/"]
